import { useContext } from 'react';
import DOMPurify from 'dompurify';
import SingleProjectContext from '../../context/SingleProjectContext';
import { motion } from 'framer-motion';

const ProjectInfo = () => {
	const { singleProjectData } = useContext(SingleProjectContext);

	return (
		<div className="flex flex-col lg:flex-row gap-12 lg:gap-16 mt-14 sm:mt-20">
			{/* Left sidebar */}
			<motion.div
				initial={{ opacity: 0, x: -20 }}
				animate={{ opacity: 1, x: 0 }}
				transition={{ duration: 0.5, delay: 0.2 }}
				className="w-full lg:w-1/3 space-y-8"
			>
				{/* Client info */}
				<div className="p-6 rounded-2xl bg-white dark:bg-white/5 border border-gray-200/50 dark:border-white/5">
					<h3 className="font-general-medium text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
						{singleProjectData.ProjectInfo.ClientHeading}
					</h3>
					<ul className="space-y-3">
						{singleProjectData.ProjectInfo.CompanyInfo.map((info) => (
							<li key={info.id} className="font-general-regular text-sm">
								<span className="text-gray-500 dark:text-gray-400">{info.title}</span>
								<br />
								{info.url ? (
									<a
										href={info.url}
										target="_blank"
										rel="noopener noreferrer"
										className="text-indigo-500 dark:text-indigo-400 hover:underline"
									>
										{info.details}
									</a>
								) : (
									<span className="text-gray-900 dark:text-white">{info.details}</span>
								)}
							</li>
						))}
					</ul>
				</div>

				{/* Objective */}
				<div className="p-6 rounded-2xl bg-white dark:bg-white/5 border border-gray-200/50 dark:border-white/5">
					<h3 className="font-general-medium text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
						{singleProjectData.ProjectInfo.ObjectivesHeading}
					</h3>
					<p className="font-general-regular text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
						{singleProjectData.ProjectInfo.ObjectivesDetails}
					</p>
				</div>

				{/* Technologies */}
				<div className="p-6 rounded-2xl bg-white dark:bg-white/5 border border-gray-200/50 dark:border-white/5">
					<h3 className="font-general-medium text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
						{singleProjectData.ProjectInfo.Technologies[0].title}
					</h3>
					<div className="flex flex-wrap gap-2">
						{singleProjectData.ProjectInfo.Technologies[0].techs.map((tech) => (
							<span
								key={tech}
								className="inline-flex items-center px-3 py-1 rounded-lg text-xs font-general-medium bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400"
							>
								{tech}
							</span>
						))}
					</div>
				</div>

				{/* Social sharing */}
				<div className="p-6 rounded-2xl bg-white dark:bg-white/5 border border-gray-200/50 dark:border-white/5">
					<h3 className="font-general-medium text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
						{singleProjectData.ProjectInfo.SocialSharingHeading}
					</h3>
					<div className="flex gap-3">
						{singleProjectData.ProjectInfo.SocialSharing.map((social) => (
							<a
								key={social.id}
								href={social.url}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.name}
								className="p-2.5 rounded-xl bg-gray-100 dark:bg-white/10 text-gray-500 dark:text-gray-400 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-indigo-500 dark:hover:text-indigo-400 transition-all duration-300"
							>
								<span className="text-lg">{social.icon}</span>
							</a>
						))}
					</div>
				</div>
			</motion.div>

			{/* Right content */}
			<motion.div
				initial={{ opacity: 0, x: 20 }}
				animate={{ opacity: 1, x: 0 }}
				transition={{ duration: 0.5, delay: 0.3 }}
				className="w-full lg:w-2/3"
			>
				<h2 className="font-general-bold text-2xl sm:text-3xl text-gray-900 dark:text-white mb-8">
					{singleProjectData.ProjectInfo.ProjectDetailsHeading}
				</h2>
				<div className="space-y-6">
					{singleProjectData.ProjectInfo.ProjectDetails.map((details) => (
						<div
							key={details.id}
							className="text-gray-600 dark:text-gray-300 text-base leading-relaxed font-general-regular prose prose-indigo dark:prose-invert max-w-none"
							dangerouslySetInnerHTML={{ __html: DOMPurify.sanitize(details.details) }}
						/>
					))}
				</div>
			</motion.div>
		</div>
	);
};

export default ProjectInfo;
